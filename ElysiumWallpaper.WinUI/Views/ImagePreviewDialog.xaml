<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="ElysiumWallpaper.Views.ImagePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Preview"
    PrimaryButtonText="Use This"
    SecondaryButtonText="Favorite"
    CloseButtonText="Close"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <!-- Override the tiny default max-size so preview fills the screen. Set in code-behind -->
        <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1400</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="RootGrid" MinWidth="800" MinHeight="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#22000000"
                CornerRadius="6">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    Margin="0,12,0,0">
            <TextBlock x:Name="PhotographerText" FontWeight="SemiBold" />
            <TextBlock x:Name="ResolutionText" Opacity="0.75" />
        </StackPanel>
    </Grid>
</ContentDialog>
