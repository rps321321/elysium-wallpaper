<?xml version="1.0" encoding="UTF-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) >= 8">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <!-- WinUI 3 unpackaged apps ship as a directory: one managed exe + loose native DLLs
         (Microsoft.ui.xaml.dll, WebView2Loader.dll, etc. can't be embedded). We distribute
         that directory as a .zip - see scripts/publish.ps1. -->
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming disabled: WinUI + CommunityToolkit.Mvvm source generators + WinRT
         marshalling all rely on reflection patterns the linker can't see. Trimming
         produces runtime crashes that only surface after publish. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>