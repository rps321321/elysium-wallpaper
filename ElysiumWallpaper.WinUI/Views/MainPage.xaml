<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ElysiumWallpaper.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ElysiumWallpaper.Views">

    <!-- Page-level keyboard shortcuts. ScopeOwner=Page so they fire from anywhere
         on the page, not just when the page itself has focus. -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Reroll_Invoked" />
        <KeyboardAccelerator Key="F5"                    Invoked="FetchNow_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!-- Layer 0: current wallpaper as full-page backdrop (lazily assigned in code-behind to avoid startup WIC crashes) -->
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               ImageFailed="Backdrop_ImageFailed" />

        <!-- Layer 1: darken + slight tint so sections stay readable -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#E5101018" />
                    <GradientStop Offset="1" Color="#F2050509" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Layer 2: actual content -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="16" Padding="24,24,8,24">
                <Border CornerRadius="14" MinHeight="90" MaxHeight="110">
                    <Grid>
                        <!-- Fallback brush shows when no wallpaper applied yet -->
                        <Border Background="{Binding SupportsRichEffects, Converter={StaticResource BoolToBrush}, ConverterParameter=HeroAcrylicBrush|HeroGradientBrush}" />

                        <!-- Current wallpaper fills the entire banner -->
                        <Image Source="{Binding CurrentImageFullPath, Converter={StaticResource PathToImage}}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ImageFailed="Backdrop_ImageFailed" />

                        <!-- Dark gradient overlay for readable text -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#CC000000" />
                                    <GradientStop Offset="1" Color="#44000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Hero text -->
                        <StackPanel Spacing="2" VerticalAlignment="Center" Padding="16,8">
                            <TextBlock Text="Elysium Wallpaper" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding StatusHeadline}" Foreground="#DFFFFFFF" FontSize="12" />
                            <TextBlock Text="{Binding CurrentImage}" Foreground="#AAFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Update available banner. Shown by the code-behind when GitHub reports a
                     newer release than the current assembly version. Action button opens the
                     release page in the user's default browser. -->
                <InfoBar x:Name="UpdateInfoBar"
                         IsOpen="False"
                         Severity="Informational"
                         Title="Update available"
                         Message="A newer version of Elysium Wallpaper is available on GitHub.">
                    <InfoBar.ActionButton>
                        <Button Content="Download" Click="OpenReleasePage_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Crash recovery banner. IsOpen is set by the code-behind on Loaded if a
                     recent crash log exists. The two action buttons reveal the log file in
                     Explorer and copy its contents to the clipboard, respectively. -->
                <InfoBar x:Name="CrashInfoBar"
                         IsOpen="False"
                         Severity="Warning"
                         Title="The app crashed previously"
                         Message="A crash log was saved. Open it or copy the details to share."
                         Closed="CrashInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Open log" Click="OpenCrashLog_Click" />
                    </InfoBar.ActionButton>
                    <Button Content="Copy details" Click="CopyCrashLog_Click" Margin="0,0,8,0" />
                </InfoBar>

            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <AutoSuggestBox Width="320"
                                        x:Name="SearchBox"
                                        Header="Tag"
                                        VerticalAlignment="Bottom"
                                        Text="{Binding SearchTag, Mode=TwoWay}"
                                        PlaceholderText="Type a tag and press Enter..."
                                        ToolTipService.ToolTip="Search Pexels by tag (Enter = search, Esc = clear)"
                                        ItemsSource="{Binding RecentTags}"
                                        KeyDown="SearchBox_KeyDown"
                                        QuerySubmitted="SearchBox_QuerySubmitted"
                                        SuggestionChosen="SearchBox_SuggestionChosen" />
                        <ComboBox Width="120"
                                  Header="Orientation"
                                  ItemsSource="{Binding OrientationOptions}"
                                  SelectedItem="{Binding SelectedOrientation, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Filter by image aspect (landscape / portrait / square)" />
                        <ComboBox Width="120"
                                  Header="Color tone"
                                  ItemsSource="{Binding ColorToneOptions}"
                                  SelectedItem="{Binding SelectedColorTone, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Filter by dominant hue" />
                        <NumberBox Width="110"
                                   Header="Min width"
                                   Value="{Binding MinWidth, Mode=TwoWay}"
                                   ToolTipService.ToolTip="Drop images narrower than this (pixels)" />
                        <NumberBox Width="110"
                                   Header="Min height"
                                   Value="{Binding MinHeight, Mode=TwoWay}"
                                   ToolTipService.ToolTip="Drop images shorter than this (pixels)" />
                        <Button Content="Search"
                                Command="{Binding SearchByTagCommand}"
                                VerticalAlignment="Bottom"
                                ToolTipService.ToolTip="Search Pexels" />
                        <ProgressRing IsActive="{Binding IsSearching}"
                                      VerticalAlignment="Bottom"
                                      Width="24"
                                      Height="24" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch Header="Match screen aspect"
                                      IsOn="{Binding MatchScreenAspect, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      ToolTipService.ToolTip="Drop images whose aspect ratio differs from your primary monitor by more than the tolerance below." />
                        <StackPanel VerticalAlignment="Bottom" Spacing="2">
                            <TextBlock Text="Aspect tolerance" FontSize="12" Opacity="0.75" />
                            <Slider Width="180"
                                    Minimum="0.05"
                                    Maximum="0.6"
                                    StepFrequency="0.05"
                                    Value="{Binding AspectTolerance, Mode=TwoWay}"
                                    IsEnabled="{Binding MatchScreenAspect}"
                                    ToolTipService.ToolTip="How far photo aspect ratio may differ from your screen (0.05 = strict, 0.6 = loose)." />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SearchStatus}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource InfoLabelStyle}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Retry"
                                    Command="{Binding SearchByTagCommand}"
                                    Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="Retry the last search" />
                            <ToggleButton x:Name="MultiSelectToggle"
                                          Content="Select"
                                          Click="MultiSelectToggle_Click"
                                          ToolTipService.ToolTip="Turn on multi-select to favorite many at once" />
                            <SelectorBar SelectionChanged="SearchViewSelector_SelectionChanged">
                            <SelectorBarItem Text="Grid" Tag="Grid" IsSelected="True" />
                            <SelectorBarItem Text="List" Tag="List" />
                            <SelectorBarItem Text="Compact" Tag="Compact" />
                        </SelectorBar>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsBulkSelectEnabled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource InfoLabelStyle}">
                            <Run Text="{Binding SelectedResultsCount}" />
                            <Run Text=" selected" />
                        </TextBlock>
                        <Button Content="Favorite all" Click="BulkFavorite_Click" />
                        <Button Content="Clear" Click="BulkClear_Click" />
                    </StackPanel>

                    <!-- GRID view: big thumbnail cards -->
                    <GridView x:Name="SearchGridView"
                              ItemsSource="{Binding SearchResults}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="SearchItem_ItemClick"
                              SelectionChanged="SearchGrid_SelectionChanged"
                              SizeChanged="ResponsiveGrid_SizeChanged"
                              Tag="260"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding SelectedSearchView, Converter={StaticResource StringEqualsVisibility}, ConverterParameter=Grid}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Apply" Tag="{Binding}" Click="UseSearchResult_Click" />
                                            <MenuFlyoutItem Text="Favorite" Tag="{Binding}" Click="SaveFavorite_Click" />
                                            <MenuFlyoutItem Text="Preview full size" Tag="{Binding}" Click="SearchCard_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Copy URL" Tag="{Binding}" Click="CopyUrl_Click" />
                                            <MenuFlyoutItem Text="Open on Pexels" Tag="{Binding}" Click="OpenOnPexels_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Clickable thumbnail (ItemClick on the GridView opens preview) -->
                                    <Grid Grid.Row="0"
                                          ToolTipService.ToolTip="Click to preview full-size">
                                        <Border CornerRadius="8" Background="#22FFFFFF">
                                            <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill" />
                                        </Border>
                                        <!-- Resolution badge overlay (top-right) -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="6"
                                                Padding="6,2"
                                                Background="#CC000000"
                                                CornerRadius="10">
                                            <TextBlock Text="{Binding QualityBadge}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Spacing="2" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Photographer}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Resolution}" FontSize="11" Opacity="0.7" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Use This" Tag="{Binding}" Click="UseSearchResult_Click" />
                                        <Button Content="Favorite" Tag="{Binding}" Click="SaveFavorite_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- LIST view: medium thumbnail + details + actions in a row -->
                    <ListView ItemsSource="{Binding SearchResults}"
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding SelectedSearchView, Converter={StaticResource StringEqualsVisibility}, ConverterParameter=List}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="6" Width="180" Height="110">
                                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Photographer}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Resolution}" Opacity="0.7" />
                                        <TextBlock Text="{Binding DownloadUrl}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="Use This" Tag="{Binding}" Click="UseSearchResult_Click" />
                                        <Button Content="Favorite" Tag="{Binding}" Click="SaveFavorite_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- COMPACT view: dense, small thumbnail -->
                    <ListView ItemsSource="{Binding SearchResults}"
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding SelectedSearchView, Converter={StaticResource StringEqualsVisibility}, ConverterParameter=Compact}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Width="64" Height="40">
                                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Photographer}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Width="160"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Resolution}"
                                               Opacity="0.6"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="Use" Tag="{Binding}" Click="UseSearchResult_Click" />
                                        <Button Content="Fav" Tag="{Binding}" Click="SaveFavorite_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pagination bar -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="&#x2039; Prev"
                                Command="{Binding PrevSearchPageCommand}"
                                IsEnabled="{Binding CanGoPrevSearchPage}"
                                ToolTipService.ToolTip="Previous page" />
                        <Button MinWidth="220"
                                Padding="12,6"
                                HorizontalContentAlignment="Center"
                                ToolTipService.ToolTip="Click to jump to a specific page">
                            <TextBlock Text="{Binding SearchPageLabel}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Jump to page" FontWeight="SemiBold" />
                                        <NumberBox x:Name="JumpPageBox"
                                                   Minimum="1"
                                                   Maximum="{Binding SearchTotalPages}"
                                                   Value="{Binding SearchPage}" />
                                        <Button Content="Go"
                                                Click="JumpToPage_Click"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="Next &#x203A;"
                                Command="{Binding NextSearchPageCommand}"
                                IsEnabled="{Binding CanGoNextSearchPage}"
                                ToolTipService.ToolTip="Next page" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel Spacing="12">
                    <SelectorBar SelectionChanged="LibraryTabSelector_SelectionChanged">
                        <SelectorBarItem Text="Favorites" Tag="Favorites" IsSelected="True" />
                        <SelectorBarItem Text="Collections" Tag="Collections" />
                        <SelectorBarItem Text="History" Tag="History" />
                    </SelectorBar>

                    <!-- Favorites panel -->
                    <StackPanel Spacing="8"
                                Visibility="{Binding SelectedLibraryTab, Converter={StaticResource StringEqualsVisibility}, ConverterParameter=Favorites}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox Width="240"
                                                Header="Filter"
                                                VerticalAlignment="Bottom"
                                                PlaceholderText="Filter favorites..."
                                                Text="{Binding FavoritesFilter, Mode=TwoWay}"
                                                ToolTipService.ToolTip="Filter by title or filename" />
                                <ComboBox Header="Sort by"
                                          Width="140"
                                          VerticalAlignment="Bottom"
                                          SelectedItem="{Binding FavoritesSort, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Reorder favorites">
                                    <x:String>Newest</x:String>
                                    <x:String>Oldest</x:String>
                                    <x:String>Title</x:String>
                                </ComboBox>
                                <ComboBox Width="220"
                                          Header="Target collection"
                                          VerticalAlignment="Bottom"
                                          PlaceholderText="Pick one"
                                          ItemsSource="{Binding Collections}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedCollectionName, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Empty state -->
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center"
                                        Padding="0,40"
                                        Visibility="{Binding Favorites.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="No favorites yet"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Click the star or &quot;Favorite&quot; on any search result to save it here."
                                           Opacity="0.7"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <GridView ItemsSource="{Binding PagedFavorites.Items}"
                                      SelectionMode="None"
                                      SizeChanged="ResponsiveGrid_SizeChanged"
                                      Tag="220"
                                      CanDragItems="True"
                                      DragItemsStarting="FavoritesGrid_DragItemsStarting"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="130" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8" Background="#22FFFFFF">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,6,0,0" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                                                <Button Content="Apply" Tag="{Binding}" Click="ApplyFavorite_Click" />
                                                <Button Content="+ Coll" Tag="{Binding}" Click="AddFavoriteToCollection_Click" />
                                                <Button Content="Remove" Tag="{Binding}" Click="RemoveFavorite_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button Content="&#x2039; Prev"
                                        Click="PrevFavoritesPage_Click"
                                        IsEnabled="{Binding PagedFavorites.CanGoPrev}" />
                                <TextBlock Text="{Binding PagedFavorites.PageLabel}"
                                           VerticalAlignment="Center"
                                           MinWidth="220"
                                           TextAlignment="Center"
                                           Style="{StaticResource InfoLabelStyle}" />
                                <Button Content="Next &#x203A;"
                                        Click="NextFavoritesPage_Click"
                                        IsEnabled="{Binding PagedFavorites.CanGoNext}" />
                            </StackPanel>
                    </StackPanel>

                    <!-- Collections panel -->
                    <StackPanel Spacing="8"
                                Visibility="{Binding SelectedLibraryTab, Converter={StaticResource StringEqualsVisibility}, ConverterParameter=Collections}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="260"
                                      Header="Active collection"
                                      VerticalAlignment="Bottom"
                                      PlaceholderText="Pick one"
                                      ItemsSource="{Binding Collections}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedCollectionName, Mode=TwoWay}" />
                            <Button Content="Apply Next"
                                    Command="{Binding ApplyNextInCollectionCommand}"
                                    VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="Drag favorites onto a row below to add them. 'Apply Next' rotates through the active collection. Create new collections from the '+ Coll' button on any favorite."
                                   Style="{StaticResource InfoLabelStyle}"
                                   TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,4"
                                            Background="Transparent"
                                            AllowDrop="True"
                                            Tag="{Binding}"
                                            DragOver="CollectionRow_DragOver"
                                            Drop="CollectionRow_Drop">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FavoriteIds.Count, Converter={StaticResource StringEqualsVisibility}, FallbackValue=''}"
                                                           Style="{StaticResource InfoLabelStyle}"
                                                           Visibility="Collapsed" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}">
                                                    <Run Text="{Binding FavoriteIds.Count}" />
                                                    <Run Text=" items" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Rename"
                                                        Tag="{Binding}"
                                                        Click="RenameCollection_Click" />
                                                <Button Content="Delete"
                                                        Tag="{Binding}"
                                                        Click="DeleteCollection_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel Spacing="4"
                                    HorizontalAlignment="Center"
                                    Padding="0,30"
                                    Visibility="{Binding Collections.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="No collections yet"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Name one above and click Create, then drag favorites into it."
                                       Opacity="0.7"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- History panel -->
                    <StackPanel Spacing="8"
                                Visibility="{Binding SelectedLibraryTab, Converter={StaticResource StringEqualsVisibility}, ConverterParameter=History}">
                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center"
                                        Padding="0,40"
                                        Visibility="{Binding History.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="No wallpapers applied yet"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Apply a wallpaper to start tracking history."
                                           Opacity="0.7"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <GridView ItemsSource="{Binding PagedHistory.Items}"
                                      SelectionMode="None"
                                      SizeChanged="ResponsiveGrid_SizeChanged"
                                      Tag="220"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="130" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="8" Background="#22FFFFFF">
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="6"
                                                        Padding="6,2"
                                                        Background="#CCE5584B"
                                                        CornerRadius="10"
                                                        Visibility="{Binding AppliedAt, Converter={StaticResource TimestampIsRecent}}">
                                                    <TextBlock Text="NEW"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding FileName}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,6,0,0" />
                                            <Button Grid.Row="2"
                                                    Content="Apply"
                                                    Tag="{Binding}"
                                                    Click="ApplyHistory_Click"
                                                    Margin="0,6,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button Content="&#x2039; Prev"
                                        Click="PrevHistoryPage_Click"
                                        IsEnabled="{Binding PagedHistory.CanGoPrev}" />
                                <TextBlock Text="{Binding PagedHistory.PageLabel}"
                                           VerticalAlignment="Center"
                                           MinWidth="220"
                                           TextAlignment="Center"
                                           Style="{StaticResource InfoLabelStyle}" />
                            <Button Content="Next &#x203A;"
                                    Click="NextHistoryPage_Click"
                                    IsEnabled="{Binding PagedHistory.CanGoNext}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />

                    <!-- #7 spatial monitor picker -->
                    <views:MonitorPickerControl x:Name="MonitorPicker"
                                                Displays="{Binding SystemSpecs.Displays}"
                                                SelectedDeviceName="{Binding SelectedMonitorId, Mode=TwoWay}"
                                                MonitorSelected="MonitorPicker_Selected" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="160"
                                  ItemsSource="{Binding LayoutModes}"
                                  SelectedItem="{Binding SelectedLayoutMode, Mode=TwoWay}" />
                        <Button Content="Auto-Assign Per Monitor"
                                Command="{Binding PerMonitorAutoAssignCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Header="Change wallpaper"
                                  Width="240"
                                  VerticalAlignment="Bottom"
                                  ItemsSource="{Binding AutoChangeOptions}"
                                  SelectedItem="{Binding AutoChangeMode, Mode=TwoWay}"
                                  ToolTipService.ToolTip="How often the engine rotates the wallpaper." />
                    </StackPanel>

                    <!-- Local folder source (interval mode uses it alongside Pexels fetches) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Local folder source"
                                   FontWeight="SemiBold"
                                   Opacity="0.8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Pick folder..."
                                    Click="PickUserFolder_Click"
                                    ToolTipService.ToolTip="Point to a folder of your own images. They'll mix into the interval-mode rotation." />
                            <Button Content="Clear"
                                    Command="{Binding ClearUserImagesFolderCommand}"
                                    Visibility="{Binding HasUserImagesFolder, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding UserImagesFolder}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="420"
                                       Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Slot boundary time pickers - active for any time-of-day based mode -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TimePicker Header="Morning starts"
                                    ClockIdentifier="24HourClock"
                                    SelectedTime="{Binding MorningStart, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Start of the morning slot." />
                        <TimePicker Header="Noon starts"
                                    ClockIdentifier="24HourClock"
                                    SelectedTime="{Binding NoonStart, Mode=TwoWay}" />
                        <TimePicker Header="Evening starts"
                                    ClockIdentifier="24HourClock"
                                    SelectedTime="{Binding EveningStart, Mode=TwoWay}" />
                        <TimePicker Header="Night starts"
                                    ClockIdentifier="24HourClock"
                                    SelectedTime="{Binding NightStart, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch Header="Tray mode"
                                      IsOn="{Binding IsTrayEnabled, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Minimize to system tray instead of taskbar." />
                        <ToggleSwitch Header="Run on startup"
                                      IsOn="{Binding IsStartupEnabled, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Launch Elysium on Windows boot." />
                        <ComboBox Header="Theme"
                                  Width="140"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Light / Dark / follow Windows theme">
                            <x:String>Default</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export Profile" Command="{Binding ExportProfileCommand}" />
                        <Button Content="Import Profile" Command="{Binding ImportProfileCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Collapsed-sidebar rail: tiny reopen button -->
        <Button Grid.Column="1"
                Content="&#x2039;"
                Click="ToggleSidebar_Click"
                ToolTipService.ToolTip="Show controls sidebar"
                AutomationProperties.Name="Show controls sidebar"
                VerticalAlignment="Top"
                Margin="0,24,4,0"
                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}" />

        <!-- Right-side fixed sidebar: Controls + System Specs -->
        <ScrollViewer Grid.Column="1" Width="280"
                      Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel Spacing="16" Margin="8,24,16,24">
                <!-- Controls -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Controls" FontSize="18" FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="&#x203A;"
                                    Click="ToggleSidebar_Click"
                                    ToolTipService.ToolTip="Hide sidebar"
                                    AutomationProperties.Name="Hide sidebar"
                                    Padding="8,2" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <Button Content="Start Engine"
                                    Command="{Binding StartEngineCommand}"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Begin auto-rotating wallpapers every 15 min based on the time-slot engine." />
                            <Button Content="Stop Engine"
                                    Command="{Binding StopEngineCommand}"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Halt the auto-rotation engine." />
                            <Button Content="Fetch Now"
                                    Command="{Binding FetchNowCommand}"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Download fresh wallpapers from Pexels and apply the current slot." />
                            <Button Content="Not This One"
                                    Command="{Binding ShuffleCurrentSlotCommand}"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Don't like it? Pull an alternative for the current slot." />
                        </StackPanel>

                        <Border Height="1"
                                Margin="0,4"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Current"
                                       FontWeight="SemiBold"
                                       Opacity="0.75"
                                       FontSize="12" />
                            <TextBlock Text="{Binding CurrentImage}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <TextBlock Text="{Binding StatusHeadline}"
                                       Style="{StaticResource InfoLabelStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- System Specs -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="System Specs"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshSystemSpecsCommand}" />
                        </Grid>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding SystemSpecs.MachineName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SystemSpecs.OsDescription}"
                                       Style="{StaticResource InfoLabelStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SystemSpecs.ProcessArchitecture}"
                                       Style="{StaticResource InfoLabelStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="CPU" FontWeight="SemiBold" Opacity="0.75" />
                            <TextBlock Text="{Binding SystemSpecs.Cpu.Name}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SystemSpecs.Cpu.Summary}"
                                       Style="{StaticResource InfoLabelStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Memory" FontWeight="SemiBold" Opacity="0.75" />
                            <TextBlock Text="{Binding SystemSpecs.Memory.Summary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="GPU" FontWeight="SemiBold" Opacity="0.75" />
                            <ItemsControl ItemsSource="{Binding SystemSpecs.Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Margin="0,2,0,6">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailLine}"
                                                       Style="{StaticResource InfoLabelStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Displays" FontWeight="SemiBold" Opacity="0.75" />
                            <ItemsControl ItemsSource="{Binding SystemSpecs.Displays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5"
                                                Margin="0,2,0,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Header}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Resolution}"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding Position}"
                                                           Style="{StaticResource InfoLabelStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</Page>
